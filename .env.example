# General System Settings
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/gasguard

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_gasguard_2026_change_in_production
JWT_EXPIRES_IN=7d

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=gasguard_backend_service
MQTT_USERNAME=gasguard_app
MQTT_PASSWORD=gasguard_secure_pass

# Firebase Cloud Messaging (FCM) Credentials
FIREBASE_PROJECT_ID=gasguard-iot
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@gasguard-iot.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# API & Application Links
API_BASE_URL=http://localhost:5000/api
ADMIN_DASHBOARD_URL=http://localhost:3000
